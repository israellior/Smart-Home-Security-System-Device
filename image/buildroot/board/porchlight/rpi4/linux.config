# The doorbell's kernel: Raspberry Pi's bcm2711_defconfig, cut by
# `make localmodconfig` to the modules in kernel-modules.txt, then saved with
# `make savedefconfig` - so this lists only what differs from the defaults.
# 1909 modules became 81. Bluetooth is off by hand: localmodconfig kept it,
# and the Pi's radio is used only for Wi-Fi.
#
# To change it: copy to .config in the kernel tree, `make menuconfig`, then
# `make savedefconfig` and copy defconfig back here. A module the doorbell
# needs also goes in kernel-modules.txt, which post-build.sh checks.
CONFIG_LOCALVERSION="-v8"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_GENERIC_IRQ_DEBUGFS=y
CONFIG_NO_HZ=y
