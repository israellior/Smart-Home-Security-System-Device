# The card, A/B:
#
#   1 MiB      raw     U-Boot's environment, first copy
#   2 MiB      raw     U-Boot's environment, second copy (uboot.fragment)
#   p1 boot    FAT     firmware, U-Boot, boot.scr, device trees - read-only
#   p2 slot A  ext4    a whole system: root filesystem with its own kernel
#   p3 slot B  ext4    the same, the spare that an update is written into
#   p4 data    ext4    this device's own files, which every update leaves alone
#
# Both slots start as the same image, so either can boot from the first day.
# MBR allows four primary partitions, which is exactly this - so the
# environment cannot have one, and lives in the gap before p1.
#
# Every partition starts on a 4 MiB boundary. SD cards erase in blocks of
# about that size, and a partition that straddles them makes the card do
# more work, and more wear, for each write. Before this p1 began at sector 1,
# leaving no room for anything, and p2 to p4 at odd sectors.

image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		}
	}

	# Room for a newer firmware and U-Boot later; 32 MB was 84% full.
	size = 64M
}

image data.ext4 {
	ext4 {
		label = "data"
		use-mke2fs = true
	}
	size = 256M
}

image sdcard.img {
	hdimage {
		align = 4M
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs-a {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition rootfs-b {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
