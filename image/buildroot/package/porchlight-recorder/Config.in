config BR2_PACKAGE_PORCHLIGHT_RECORDER
	bool "porchlight-recorder"
	depends on BR2_PACKAGE_PORCHLIGHTD
	# The stacks are chosen in the defconfig, because each pulls in a lot
	# and a reader of this menu should see them asked for; this package
	# then asks for the particular elements the recorder's pipeline names.
	depends on BR2_PACKAGE_GSTREAMER1
	depends on BR2_PACKAGE_GST1_PLUGINS_BASE
	depends on BR2_PACKAGE_GST1_PLUGINS_GOOD
	depends on BR2_PACKAGE_GST1_PLUGINS_BAD
	depends on BR2_PACKAGE_GST1_PLUGINS_UGLY
	depends on BR2_PACKAGE_GST1_LIBAV       # avenc_aac
	depends on BR2_PACKAGE_LIBCAMERA        # libcamerasrc
	depends on BR2_PACKAGE_GST1_PYTHON      # record-clip.py: from gi.repository import Gst
	# alsasrc, videoconvert, audioconvert, audioresample, and the test
	# sources the recorder falls back to with --video test / --audio test.
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_ALSA
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERTSCALE
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIOCONVERT
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIORESAMPLE
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOTESTSRC
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIOTESTSRC
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ISOMP4        # mp4mux
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUDIOPARSERS  # aacparse
	select BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS   # h264parse
	select BR2_PACKAGE_GST1_PLUGINS_UGLY_PLUGIN_X264          # x264enc
	# The Pi's own camera pipeline: the IMX708 through the VideoCore ISP.
	select BR2_PACKAGE_LIBCAMERA_PIPELINE_RPI_VC4
	help
	  record-clip.py and upload-clip.py: the clips porchlightd records
	  on a ring or motion, and the three-step upload that sends them.

comment "porchlight-recorder needs GStreamer, gst1-libav, libcamera and gst1-python"
	depends on BR2_PACKAGE_PORCHLIGHTD
	depends on !BR2_PACKAGE_GSTREAMER1 || !BR2_PACKAGE_GST1_LIBAV || \
		!BR2_PACKAGE_LIBCAMERA || !BR2_PACKAGE_GST1_PYTHON
