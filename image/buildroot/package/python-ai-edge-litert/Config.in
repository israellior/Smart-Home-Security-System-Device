config BR2_PACKAGE_PYTHON_AI_EDGE_LITERT
	bool "python-ai-edge-litert"
	depends on BR2_PACKAGE_PYTHON3
	# A prebuilt wheel: Google's aarch64 build, linked against glibc 2.34
	# or newer and a CPython 3.14 extension, so it runs on this image's
	# Python and nothing else.
	depends on BR2_aarch64
	depends on BR2_TOOLCHAIN_USES_GLIBC
	# Repeated from python-numpy, because select does not check them.
	depends on BR2_PACKAGE_PYTHON_NUMPY_ARCH_SUPPORTS
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_9
	select BR2_PACKAGE_PYTHON_NUMPY
	help
	  The TensorFlow Lite interpreter (ai_edge_litert.interpreter), from
	  Google's prebuilt manylinux aarch64 wheel. Only the interpreter is
	  installed: the wheel's converter, compiled-model API and WebGPU
	  accelerator are 24 MB nothing here uses.

	  https://github.com/google-ai-edge/LiteRT
