#!/bin/sh
# Decide whether the system that just booted is good, and tell RAUC.
#
# Good means porchlightd has run for 60 s without restarting. Not "reached the
# server": a customer's internet being down is no reason to roll back an
# update that works, and the daemon stays up through any outage by design.
#
# A slot booting a freshly installed update is on trial: if it is not good
# within five minutes it is marked bad and the device reboots, and U-Boot
# falls back to the other slot at once. A slot that has proven itself before is
# never rolled back from here - a daemon struggling there is more likely the
# hardware or the network, which the older system would not fix.

SLOT=$(sed -n 's/.*rauc\.slot=\([AB]\).*/\1/p' /proc/cmdline)
STEADY_SECONDS=60
DEADLINE_SECONDS=300

if [ -z "$SLOT" ]; then
	echo "porchlight-health: no rauc.slot on the kernel command line; nothing to judge"
	exit 0
fi

# Which install put this slot's system there, from RAUC's own status file on
# /data - read directly, not through `rauc status --output-format=json`, which
# this RAUC is built without: that printed nothing, an empty answer read as
# "never installed", and a broken update was waved through as proven.
#
# No file, or no section for the slot: nothing was ever installed there, so it
# is the factory image, which was tested before it shipped. Anything that
# cannot be read is "unknown", and unknown is on trial: not knowing must never
# be what turns the rollback off.
STATUS=/data/rauc/central.raucs
case "$SLOT" in A) SECTION=slot.rootfs.0 ;; B) SECTION=slot.rootfs.1 ;; esac
installed=$(python3 - "$STATUS" "$SECTION" <<'EOF'
import configparser, os, sys
path, section = sys.argv[1:3]
if not os.path.exists(path):
    print("")
    sys.exit(0)
try:
    status = configparser.ConfigParser(interpolation=None)
    status.read(path)
except (OSError, configparser.Error):
    print("unknown")
    sys.exit(0)
if not status.has_section(section):
    print("")
else:
    # The transaction is unique per install; the timestamp is the fallback.
    s = status[section]
    print(s.get("installed.transaction") or s.get("installed.timestamp") or "unknown")
EOF
) || installed=unknown

proven=/data/rauc/proven-$SLOT
trial=no
if [ "$installed" = unknown ]; then
	trial=yes
	echo "porchlight-health: cannot read what was installed in slot $SLOT; treating it as on trial"
elif [ -n "$installed" ] && [ "$(cat "$proven" 2>/dev/null)" != "$installed" ]; then
	trial=yes
	echo "porchlight-health: slot $SLOT is on trial (install $installed)"
else
	echo "porchlight-health: slot $SLOT is ${installed:+proven (install $installed)}${installed:-the factory system}"
fi

uptime_us() { awk '{ printf "%d", $1 * 1000000 }' /proc/uptime; }

start=$(uptime_us)
while [ $(( $(uptime_us) - start )) -lt $(( DEADLINE_SECONDS * 1000000 )) ]; do
	if [ "$(systemctl is-active porchlightd)" = active ]; then
		since=$(systemctl show -p ActiveEnterTimestampMonotonic --value porchlightd)
		if [ $(( $(uptime_us) - since )) -ge $(( STEADY_SECONDS * 1000000 )) ]; then
			rauc status mark-good >/dev/null
			[ "$trial" = yes ] && echo "$installed" > "$proven"
			echo "porchlight-health: porchlightd steady for ${STEADY_SECONDS}s; slot $SLOT marked good"
			exit 0
		fi
	fi
	sleep 5
done

if [ "$trial" = yes ]; then
	echo "porchlight-health: porchlightd never ran ${STEADY_SECONDS}s steadily; slot $SLOT is bad, falling back"
	rauc status mark-bad >/dev/null
	systemctl reboot
else
	echo "porchlight-health: porchlightd is not steady, but slot $SLOT has proven itself before; not rolling back"
fi
exit 1
