#!/bin/sh
# Decide whether the system that just booted is good, and tell RAUC.
#
# Good means porchlightd has run for 60 s without restarting. Not "reached the
# server": a customer's internet being down is no reason to roll back an
# update that works, and the daemon stays up through any outage by design.
#
# A slot booting a freshly installed update is on trial: if it is not good
# within five minutes it is marked bad and the device reboots, and U-Boot
# falls back to the other slot at once. A slot that has proven itself before is
# never rolled back from here - a daemon struggling there is more likely the
# hardware or the network, which the older system would not fix.

SLOT=$(sed -n 's/.*rauc\.slot=\([AB]\).*/\1/p' /proc/cmdline)
STEADY_SECONDS=60
DEADLINE_SECONDS=300

if [ -z "$SLOT" ]; then
	echo "porchlight-health: no rauc.slot on the kernel command line; nothing to judge"
	exit 0
fi

# When RAUC last installed into this slot. Empty for a slot that came from the
# factory image, which was tested before it shipped.
installed=$(rauc status --detailed --output-format=json 2>/dev/null | python3 -c '
import json, sys
slot = sys.argv[1]
try:
    status = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
for entry in status.get("slots", []):
    for info in entry.values():
        if info.get("bootname") == slot:
            print(info.get("slot_status", {}).get("installed", {}).get("timestamp", ""))
' "$SLOT")

proven=/data/rauc/proven-$SLOT
trial=no
if [ -n "$installed" ] && [ "$(cat "$proven" 2>/dev/null)" != "$installed" ]; then
	trial=yes
	echo "porchlight-health: slot $SLOT is on trial (installed $installed)"
fi

uptime_us() { awk '{ printf "%d", $1 * 1000000 }' /proc/uptime; }

start=$(uptime_us)
while [ $(( $(uptime_us) - start )) -lt $(( DEADLINE_SECONDS * 1000000 )) ]; do
	if [ "$(systemctl is-active porchlightd)" = active ]; then
		since=$(systemctl show -p ActiveEnterTimestampMonotonic --value porchlightd)
		if [ $(( $(uptime_us) - since )) -ge $(( STEADY_SECONDS * 1000000 )) ]; then
			rauc status mark-good >/dev/null
			[ "$trial" = yes ] && echo "$installed" > "$proven"
			echo "porchlight-health: porchlightd steady for ${STEADY_SECONDS}s; slot $SLOT marked good"
			exit 0
		fi
	fi
	sleep 5
done

if [ "$trial" = yes ]; then
	echo "porchlight-health: porchlightd never ran ${STEADY_SECONDS}s steadily; slot $SLOT is bad, falling back"
	rauc status mark-bad >/dev/null
	systemctl reboot
else
	echo "porchlight-health: porchlightd is not steady, but slot $SLOT has proven itself before; not rolling back"
fi
exit 1
