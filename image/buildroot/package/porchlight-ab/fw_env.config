# Where U-Boot keeps its environment, for fw_printenv / fw_setenv - and so for
# RAUC. U-Boot for the Pi saves it as a file on the FAT boot partition, which
# Linux mounts at /boot/firmware. The size must match U-Boot's
# CONFIG_ENV_SIZE, or both sides read each other's environment as corrupt.
#
# file                       offset   size
/boot/firmware/uboot.env     0x0000   0x4000
