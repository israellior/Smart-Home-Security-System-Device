config BR2_PACKAGE_PORCHLIGHT_FACE_MODELS
	bool "porchlight-face-models"
	# Same runtime as the person detector, and faces are only looked for
	# once it has found a person.
	depends on BR2_PACKAGE_PORCHLIGHT_DETECT
	help
	  The two models porchlight-faces.py runs: BlazeFace full-range
	  (MediaPipe) to find faces and their eyes, nose and mouth, and SFace
	  (OpenCV zoo, converted to TFLite by convert-sface.sh) to turn a
	  straightened face into a code. Both Apache 2.0. About 40 MB, nearly
	  all of it SFace.

comment "porchlight-face-models needs porchlight-detect"
	depends on !BR2_PACKAGE_PORCHLIGHT_DETECT
