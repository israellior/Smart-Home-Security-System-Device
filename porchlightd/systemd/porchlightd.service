[Unit]
Description=Porchlight doorbell daemon
After=network.target

# A restart loop is the wrong answer to the one failure that restarts cannot
# fix: a config file that will not parse. The daemon exits 1 immediately on
# that, and without a limit systemd would run it every two seconds forever,
# filling the journal with the same line and hiding it in its own repetition.
# Five tries in five minutes, then stop and say so - `systemctl status` then
# shows the reason rather than the current attempt.
#
# Losing the *network* never gets here: the daemon stays up for that, queues
# its alerts and goes on chiming, which is the whole point of it being a
# daemon rather than a script.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/porchlightd /etc/porchlight/porchlightd.json
Restart=on-failure
RestartSec=2

# Shutdown drains rather than stopping dead: the recorder child gets SIGINT so
# its MP4 finishes with EOS, SIGKILL at +5s, and a live call gets SIGTERM so it
# leaves the LiveKit room instead of being killed in it - otherwise whoever is
# watching keeps a frozen picture until the server times the participant out.
# The daemon is out by about +10s. This has to stay above that.
TimeoutStopSec=15
KillSignal=SIGTERM

User=porchlight
# The sound card, the camera and the GPIO lines.
SupplementaryGroups=audio video gpio

# Creates and owns /var/lib/porchlight, which holds the clip spool.
StateDirectory=porchlight

StandardOutput=journal
StandardError=journal

# The stdin input backend is for development only; systemd gives a service no
# terminal. Set backends.input to a real one before enabling this unit.
StandardInput=null

[Install]
WantedBy=multi-user.target
