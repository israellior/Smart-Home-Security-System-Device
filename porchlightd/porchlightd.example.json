{
  "device_id": "porch-1",
  "log_level": "info",

  "backends": {
    "input": "stdin",
    "led": "console",
    "chime": "alsa",
    "server": "bridge",
    "uploader": "script",
    "media": "script",
    "recorder": "gstreamer"
  },

  "timings": {
    "clip_seconds": 15,
    "min_clip_seconds": 2,
    "motion_cooldown_seconds": 25,
    "press_dedup_window_seconds": 5,
    "ring_led_seconds": 5,
    "alert_max_age_seconds": 86400,
    "max_queued_alerts": 200,
    "retry_backoff_initial_seconds": 2,
    "retry_backoff_max_seconds": 60
  },

  "server": {
    "base_url": "http://192.168.0.219:4000",
    "credential_path": "/etc/porchlight/credential",
    "bridge_path": "/usr/local/lib/porchlight/server-bridge.py",
    "uploader_path": "/usr/local/lib/porchlight/upload-clip.py",
    "ack_timeout_seconds": 10
  },

  "chime": {
    "device": "plughw:CARD=wm8960soundcard",
    "sound": "/usr/local/share/porchlight/chime.wav"
  },

  "spool": {
    "path": "/var/lib/porchlight/spool",
    "max_bytes": 536870912
  },

  "recorder": {
    "video_source": "libcamera",
    "audio_source": "alsa",
    "audio_device": "hw:CARD=wm8960soundcard",
    "encoder": "x264",
    "aac_element": "avenc_aac",
    "width": 640,
    "height": 360,
    "fps": 30,
    "video_bitrate_kbps": 2000
  },

  "media": {
    "python": "/opt/porchlight/venv/bin/python3",
    "script": "/usr/local/lib/porchlight/webrtc-video.py",
    "video_source": "camera",
    "width": 640,
    "height": 360,
    "fps": 30,
    "codec": "h264",
    "video_bitrate_kbps": 1500,
    "focus": "continuous",
    "audio_source": "alsa",
    "mic_device": "hw:CARD=wm8960soundcard",
    "speaker_device": "hw:CARD=wm8960soundcard",
    "talkback": true,
    "echo_cancel": true,
    "idle_timeout_seconds": 30,
    "linger_seconds": 3
  },

  "gpio": {
    "chip": "/dev/gpiochip0",
    "button_line": 24,
    "motion_line": 23,
    "led_line": 25,
    "button_active_low": true,
    "motion_active_low": false,
    "led_active_low": false,
    "debounce_ms": 30
  }
}
